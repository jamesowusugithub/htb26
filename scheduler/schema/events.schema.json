{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpu-scheduling-lens/events/0.2.0",
  "title": "One line of an NDJSON run file (also the WebSocket batch items)",
  "description": "First line is `meta`; then arrive/start/finish/preempt/fail/repair/thermal_alert events and periodic `snapshot` lines in time order. Times are seconds since window start. Waits, starts, evictions, failures and node placement are SIMULATED; board temperature/power are a PROXY from measured H100 profiles; forecasts are projections with measured skill. The frontend must only display these values.",
  "oneOf": [
    {"$ref": "#/$defs/meta"}, {"$ref": "#/$defs/arrive"}, {"$ref": "#/$defs/start"}, {"$ref": "#/$defs/finish"},
    {"$ref": "#/$defs/preempt"}, {"$ref": "#/$defs/fail"}, {"$ref": "#/$defs/repair"},
    {"$ref": "#/$defs/thermal_alert"}, {"$ref": "#/$defs/snapshot"}
  ],
  "$defs": {
    "poolId": {"type": "string", "description": "a10 | a100 | a800 | h800 | series1 | series2"},
    "board": {"type": ["integer", "null"], "description": "0..23 display board (a slice of a pod pool's nodes); null when the pool is not displayed"},
    "meta": {
      "type": "object", "required": ["type", "schema_version", "time_unit", "window", "policy", "pools", "display", "thermal", "forecast", "assumptions"],
      "properties": {
        "type": {"const": "meta"}, "schema_version": {"const": "0.2.0"}, "time_unit": {"type": "string"},
        "window": {"type": "object"}, "policy": {"type": "object"},
        "pools": {"type": "array", "items": {"type": "object", "required": ["id", "label", "capacity_gpus", "nodes"]}},
        "display": {"type": "object", "required": ["pods", "boards", "boards_per_pod"],
          "properties": {"boards": {"type": "array", "items": {"type": "object", "required": ["index", "pod", "pool", "nodes", "capacity_gpus"]}},
                         "pods": {"type": "array", "items": {"type": "object", "required": ["pod", "pool", "label", "boards"]}}}},
        "thermal": {"type": "object", "required": ["evidence", "source_gpu", "disclaimer", "assumptions"],
          "properties": {"evidence": {"const": "proxy"}}},
        "forecast": {"type": "object", "required": ["horizon_s", "evidence"],
          "properties": {"horizon_s": {"type": "number"}, "pairs": {"type": "integer"},
                         "mae_util_pct_points": {"type": ["number", "null"]}, "chosen": {"type": "string"}, "projection_mae_util_pct_points": {"type": ["number", "null"]}, "projection_beats_persistence": {"type": "boolean"},
                         "persistence_mae_util_pct_points": {"type": ["number", "null"]}}},
        "assumptions": {"type": "array", "items": {"type": "object", "required": ["key", "evidence", "note"],
          "properties": {"evidence": {"enum": ["observed", "calculated", "assumption"]}}}}
      }
    },
    "arrive": {"type": "object", "required": ["type", "t", "job", "pool", "gpus", "priority", "duration_s"],
      "properties": {"type": {"const": "arrive"}, "t": {"type": "number"}, "job": {"type": "string"}, "pool": {"$ref": "#/$defs/poolId"},
                     "gpus": {"type": "number"}, "priority": {"enum": ["hp", "spot"]}, "duration_s": {"type": "number"},
                     "carryover": {"type": "boolean"}, "warm": {"type": "boolean", "description": "t<=0: state already present when the window opens; do not animate"},
                     "evidence": {"type": "string"}}},
    "start": {"type": "object", "required": ["type", "t", "job", "pool", "node", "gpu_slots", "board", "service_s"],
      "properties": {"type": {"const": "start"}, "t": {"type": "number"}, "job": {"type": "string"}, "pool": {"$ref": "#/$defs/poolId"},
                     "node": {"type": "integer"}, "board": {"$ref": "#/$defs/board"}, "gpu_slots": {"type": "array", "items": {"type": "integer"}},
                     "attempt": {"type": "integer", "description": "1 = first start, >1 = restart after preemption or failure"},
                     "service_s": {"type": "number", "description": "service time this attempt needs (progress = elapsed / service_s)"},
                     "gpus": {"type": "number"}, "priority": {"enum": ["hp", "spot"]}, "warm": {"type": "boolean"}}},
    "finish": {"type": "object", "required": ["type", "t", "job", "pool", "wait_s"],
      "properties": {"type": {"const": "finish"}, "t": {"type": "number"}, "job": {"type": "string"}, "pool": {"$ref": "#/$defs/poolId"},
                     "node": {"type": "integer"}, "board": {"$ref": "#/$defs/board"}, "wait_s": {"type": "number"}}},
    "preempt": {"type": "object", "required": ["type", "t", "job", "pool", "node", "gpu_slots", "cause"],
      "properties": {"type": {"const": "preempt"}, "t": {"type": "number"}, "job": {"type": "string"}, "pool": {"$ref": "#/$defs/poolId"},
                     "node": {"type": "integer"}, "board": {"$ref": "#/$defs/board"}, "gpu_slots": {"type": "array", "items": {"type": "integer"}},
                     "work_lost_gpu_s": {"type": "number"}, "cause": {"enum": ["priority_preemption", "node_failure"]}}},
    "fail": {"type": "object", "required": ["type", "t", "pool", "node", "board"],
      "properties": {"type": {"const": "fail"}, "t": {"type": "number"}, "pool": {"$ref": "#/$defs/poolId"}, "node": {"type": "integer"},
                     "board": {"$ref": "#/$defs/board"}, "evidence": {"const": "scenario"}}},
    "repair": {"type": "object", "required": ["type", "t", "pool", "node", "board"],
      "properties": {"type": {"const": "repair"}, "t": {"type": "number"}, "pool": {"$ref": "#/$defs/poolId"}, "node": {"type": "integer"},
                     "board": {"$ref": "#/$defs/board"}, "evidence": {"const": "scenario"}}},
    "thermal_alert": {"type": "object", "required": ["type", "t", "board", "state", "temp_c", "threshold_c", "evidence"],
      "properties": {"type": {"const": "thermal_alert"}, "t": {"type": "number"}, "board": {"type": "integer"}, "pool": {"$ref": "#/$defs/poolId"},
                     "state": {"enum": ["on", "off"]}, "temp_c": {"type": "number"}, "threshold_c": {"type": "number"}, "evidence": {"const": "proxy"}}},
    "snapshot": {"type": "object", "required": ["type", "t", "pools", "boards"],
      "properties": {"type": {"const": "snapshot"}, "t": {"type": "number"}, "cooling_fault_delta_c": {"type": "number"},
        "pools": {"type": "object", "additionalProperties": {"type": "object",
          "required": ["busy_gpus", "capacity_gpus", "queue_hp", "queue_spot", "running_jobs", "queue_head", "completed", "arrived"],
          "properties": {"busy_gpus": {"type": "number"}, "capacity_gpus": {"type": "number"}, "queue_hp": {"type": "integer"},
                         "queue_spot": {"type": "integer"}, "running_jobs": {"type": "integer"}, "max_free_gpus_on_one_node": {"type": "integer"},
                         "completed": {"type": "integer"}, "arrived": {"type": "integer"},
                         "queue_head": {"type": "array", "items": {"type": "object", "required": ["job", "priority", "gpus"]}}}}},
        "boards": {"type": "array", "items": {"type": "object",
          "required": ["i", "util_pct", "temp_c", "power_w", "running_jobs", "nodes", "nodes_down", "status", "alert", "forecast"],
          "properties": {"i": {"type": "integer"}, "util_pct": {"type": "number"}, "temp_c": {"type": "number"},
                         "power_w": {"type": ["number", "null"]}, "running_jobs": {"type": "integer"}, "nodes": {"type": "integer"},
                         "nodes_down": {"type": "integer"}, "status": {"enum": ["idle", "running", "cooling", "failed"]},
                         "alert": {"type": "boolean"},
                         "forecast": {"type": "object", "required": ["util_pct", "temp_c", "power_w"],
                           "properties": {"util_pct": {"type": "number"}, "temp_c": {"type": "number"}, "power_w": {"type": ["number", "null"]}}}}}}}}
  }
}
